# Copy to .env for local runs. On Railway set these as service Variables instead.

# Password the team uses to log in to the app
APP_PASSWORD=change-me
# Random long string used to sign login cookies (e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Bitrix24 incoming webhook (Разработчикам -> Другое -> Входящий вебхук), scopes: crm, catalog
# Looks like: https://yourcompany.bitrix24.ru/rest/1/abcdef123456/
BITRIX_WEBHOOK_URL=

# AI model - any OpenAI-compatible chat completions API
# Examples: https://api.openai.com/v1 , https://api.deepseek.com/v1 , https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Set to false if your provider rejects response_format: {"type":"json_object"}
AI_JSON_MODE=true
# Set to false if your model cannot read images (photos/screenshots will then be rejected)
AI_VISION=true

# Defaults for new products
DEFAULT_VAT_RATE=12
DEFAULT_CURRENCY=UZS

# Local development only: MOCK_AI=true returns a sample product instead of calling the AI
MOCK_AI=false
PORT=3000
